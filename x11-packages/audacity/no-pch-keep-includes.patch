Some Muse sources rely on includes from pch.h. Keep including it as a normal
header when disabling PCH to work around NDK r30 Clang crashes.

--- a/muse/framework/cmake/MuseCreateModule.cmake
+++ b/muse/framework/cmake/MuseCreateModule.cmake
@@ -106,6 +106,11 @@
     if (NOT arg_NO_PCH AND MUSE_COMPILE_USE_PCH)
         target_precompile_headers_clang_ccache(${target_name} REUSE_FROM muse_pch)
         target_link_libraries(${target_name} PRIVATE muse_pch)
+    elseif (NOT arg_NO_PCH)
+        target_compile_options(${target_name} PRIVATE
+            "$<$<COMPILE_LANGUAGE:CXX>:SHELL:-include ${MUSE_FRAMEWORK_PATH}/buildscripts/pch/pch.h>"
+        )
+        target_link_libraries(${target_name} PRIVATE Qt::Core Qt::Gui Qt::Quick)
     endif()
 
     # Unity build
