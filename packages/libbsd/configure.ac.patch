Select the API/ABI set for Android.

configure.ac has no case for Android, so every abi_* / api_* variable is
left at "unknown" and configure aborts with:

  configure: error: unknown ABI selection for time_macros

Android/bionic is close enough to the glibc selection, so reuse that
branch, with three deviations:

 - abi_funopen: bionic provides funopen() (see the ac_cv_func_funopen=yes
   cache variable in build.sh), so libbsd must not export its own.
 - abi_progname: bionic provides __progname, so the libbsd replacement
   would collide with it.
 - abi_transparent_libmd: libmd is a separate Termux package that libbsd
   links against, so libbsd must not re-export its symbols.

This used to be patched into the generated `configure` instead, but
build.sh now runs `autoreconf -fi`, which regenerates `configure` from
configure.ac and threw those changes away.

--- a/configure.ac
+++ b/configure.ac
@@ -87,7 +87,7 @@ abi_vis=unknown
 abi_wcsl=unknown

 AS_CASE([$host_os],
-  [*-gnu* | gnu*], [
+  [*-gnu* | gnu* | *android*], [
     api_time_macros=no

     abi_accmode=yes
@@ -111,7 +111,7 @@ AS_CASE([$host_os],
     abi_fmtcheck=yes
     abi_fpurge=yes
     abi_freezero=yes
-    abi_funopen=yes
+    abi_funopen=no
     abi_getbsize=yes
     abi_getpeereid=yes
     abi_humanize_number=yes
@@ -126,7 +126,7 @@ AS_CASE([$host_os],
     abi_nlist=yes
     abi_pidfile=yes
     abi_proctitle=yes
-    abi_progname=yes
+    abi_progname=no
     abi_readpassphrase=yes
     # DROP: On glibc >= 2.26.
     #abi_reallocarray=no
@@ -449,7 +449,7 @@ AS_IF([test "$abi_md5" = "yes"], [
   AC_SEARCH_LIBS([MD5Update], [md], [
     AS_IF([test "x$ac_cv_search_MD5Update" != "xnone required"], [
       MD5_LIBS="$MD5_LIBS $ac_cv_search_MD5Update"
-      abi_transparent_libmd=yes
+      abi_transparent_libmd=no
     ])
   ], [
     AC_MSG_ERROR([cannot find required MD5 functions in libc or libmd])
